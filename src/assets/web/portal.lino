(page
  (title 'Runner portal · Hive Runners')
  (header (class 'shell top')
    (a (class brand) (href /)
      (span (aria-hidden true) (content H))
      (copy (content ' Hive Runners')))
    (nav (aria-label Main) (a (href /docs) (content Docs))))
  (main (class 'shell interior')
    (h1 (content 'Runner portal'))
    (p (class lede)
      (content 'Use the account key from your fleet operator to check credit, add funds, and activate your runner pool.'))
    (form (id login)
      (label (content 'Runner account key')
        (input (id key) (type password) (required true) (minlength 32) (maxlength 512) (autocomplete off)))
      (button (class button) (type submit) (content 'Open account')))
    (p (id status) (role status))
    (section (id account) (aria-labelledby account-heading) (hidden true)
      (h2 (id account-heading) (content 'Your runner pool'))
      (p (id summary))
      (p (id activation))
      (pre (id example))
      (form (id activate)
        (label (content 'Activation window (minutes)')
          (input (id minutes) (type number) (min 1) (max 60) (value 30) (required true)))
        (label (content 'Spending limit in USD (optional)')
          (input (id budget) (type number) (min 0.01) (step 0.01) (aria-describedby budget-help)))
        (p (id budget-help) (content 'Leave blank to cap this activation at your current credit.'))
        (button (class button) (type submit) (content 'Activate runners')))
      (p (button (id stop) (class 'button outline') (type button) (content 'End activation')))
      (div (id payment) (hidden true)
        (h2 (content 'Add execution credit'))
        (form (id checkout)
          (label (content 'Top-up (USD)')
            (input (id amount) (type number) (min 5) (max 1000) (step 0.01) (value 10) (required true)))
          (button (class 'button outline') (type submit) (content 'Continue to checkout ')
            (span (aria-hidden true) (content ↗))))))))
