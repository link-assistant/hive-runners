(page
  (title 'Hive Runners · Self-hosted CI')
  (description 'Run private GitHub Actions and GitLab CI on your own Linux fleet. Use existing CPU or GPU hosts and provision capacity when jobs queue up.')
  (header (class 'shell top')
    (a (class brand) (href /)
      (span (aria-hidden true) (content H))
      (copy (content ' Hive Runners')))
    (nav (aria-label Main)
      (a (href /docs) (content Docs))
      (a (class 'button small outline') (href /portal)
        (content 'Runner portal ')
        (span (aria-hidden true) (content ↗)))))
  (main
    (section (class 'shell hero')
      (div (class hero-copy)
        (p (class eyebrow)
          (i (aria-hidden true))
          (copy (content ' SELF-HOSTED GITHUB ACTIONS AND GITLAB CI')))
        (h1 (content 'Your runners.') (br) (em (content 'Your fleet.')))
        (p (class lede)
          (content 'Run private GitHub Actions and GitLab CI on your own infrastructure. Use Linux hosts and GPUs you already have, and add VPS capacity as your queue grows.'))
        (div (class actions)
          (a (class button) (href /docs) (content 'Deploy a fleet ')
            (span (aria-hidden true) (content ↗)))
          (a (class 'button outline') (href 'https://github.com/link-assistant/hive-runners')
            (content 'View source'))))
      (figure (class hardware)
        (img (src /runner-hardware.webp) (width 1120) (height 747)
          (alt 'Compact lavender and cream servers with green status lights'))
        (figcaption
          (span (i (aria-hidden true)) (copy (content ' Fleet architecture')))
          (span (content 'MINIKUBE')))))
    (section (class 'shell modes') (aria-labelledby mode-heading)
      (div (class section-top)
        (h2 (id mode-heading) (content 'Choose how you host.'))
        (a (href /docs) (content 'Read the deployment guide ')
          (span (aria-hidden true) (content ↗))))
      (div (class cards)
        (article
          (div (class mode-icon) (aria-hidden true) (content ▤))
          (h3 (content 'Private fleet'))
          (p (content 'Run ephemeral jobs on Contabo, Hetzner, or Linux hosts you already manage.')))
        (article
          (div (class mode-icon) (aria-hidden true) (content ◷))
          (h3 (content 'Metered runners'))
          (p (content 'Sell spare capacity through dedicated runner pools and charge for execution time.')))
        (article
          (div (class mode-icon) (aria-hidden true) (content ⇄))
          (h3 (content 'Connected suppliers'))
          (p (content 'Offer one customer portal while sourcing runner capacity from partner fleets.'))))))
  (footer (class 'shell footer')
    (span (content 'Hive Runners'))
    (a (href 'https://github.com/link-assistant/hive-runners') (content 'Open source on GitHub ')
      (span (aria-hidden true) (content ↗)))))
